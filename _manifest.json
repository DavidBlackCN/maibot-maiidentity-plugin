{
  "manifest_version": 2,
  "id": "davidblackcn.maibot-maiidentity-plugin",
  "version": "3.2.1",
  "name": "MaiIdentity",
  "description": "Account identity and confirmed relations; official Host command entry; self service and Vita command policy.",
  "author": {
    "name": "DavidBlackCN",
    "url": "https://github.com/DavidBlackCN"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/DavidBlackCN/maibot-maiidentity-plugin",
    "homepage": "https://github.com/DavidBlackCN/maibot-maiidentity-plugin"
  },
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "1.3.15"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "2.16.0"
  },
  "dependencies": [],
  "capabilities": [
    "message.get_by_id",
    "config.get",
    "component.list_loaded_plugins",
    "send.text"
  ],
  "plugin_type": "extension",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ],
    "locales_path": "_locales"
  }
}
